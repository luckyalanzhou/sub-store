#!/bin/sh /etc/rc.common

START=99
STOP=10

start() {
	if [ -x /usr/lib/sub-store/install-recovery ]; then
		/usr/lib/sub-store/install-recovery || return 1
	fi
    /usr/bin/sub-storectl start
}

stop() {
    /usr/bin/sub-storectl stop
}

reload() {
    /usr/bin/sub-storectl restart
}

restart() {
    /usr/bin/sub-storectl restart
}

status() {
    /usr/bin/sub-storectl status
}
