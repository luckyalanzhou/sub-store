#!/bin/sh
set -eu

DATA_VOLUME=sub-store-data

fail() {
    echo "sub-store export-data: $*" >&2
    exit 1
}

daemon_ready() {
    if docker info >/dev/null 2>&1; then
        return 0
    fi
    [ -x /etc/init.d/dockerd ] && /etc/init.d/dockerd start >/dev/null 2>&1 || true
    n=0
    while [ "$n" -lt 30 ]; do
        docker info >/dev/null 2>&1 && return 0
        n=$((n + 1))
        sleep 2
    done
    fail "Docker daemon did not become ready"
}

ensure_data_volume() {
    if ! docker volume inspect "$DATA_VOLUME" >/dev/null 2>&1; then
        docker volume create "$DATA_VOLUME" >/dev/null || fail "could not create Docker volume $DATA_VOLUME"
    fi
    VOLUME_PATH="$(docker volume inspect -f '{{.Mountpoint}}' "$DATA_VOLUME" 2>/dev/null || true)"
    case "$VOLUME_PATH" in
        /*) ;;
        *) fail "Docker did not return a valid mountpoint for volume $DATA_VOLUME" ;;
    esac
    case "$VOLUME_PATH" in
        /|*//*|*/../*|*/..|*/./*|*/.) fail "Docker returned an unsafe volume mountpoint: $VOLUME_PATH" ;;
    esac
    [ -d "$VOLUME_PATH" ] || fail "Docker volume mountpoint does not exist: $VOLUME_PATH"
}

target="${1:-}"
[ "$#" -eq 1 ] && [ -n "$target" ] || fail "usage: sub-storectl export-data /absolute/path/sub-store-data.tar.gz"
case "$target" in /*) ;; *) fail "export destination must be an absolute path" ;; esac
daemon_ready
ensure_data_volume
target_dir="${target%/*}"
[ -n "$target_dir" ] || target_dir=/
[ -d "$target_dir" ] || fail "export destination directory does not exist: $target_dir"
[ ! -d "$target" ] || fail "export destination must be a file, not a directory"
case "$target" in "$VOLUME_PATH"|"$VOLUME_PATH"/*) fail "export destination cannot be inside the data volume" ;; esac
resolved_volume_path="$(cd -P "$VOLUME_PATH" 2>/dev/null && pwd -P)" || fail "could not resolve the data volume path"
resolved_target_dir="$(cd -P "$target_dir" 2>/dev/null && pwd -P)" || fail "could not resolve the export destination directory"
case "$resolved_target_dir" in
    "$resolved_volume_path"|"$resolved_volume_path"/*) fail "export destination cannot be inside the data volume" ;;
esac
if [ "$resolved_target_dir" = "/" ]; then
    resolved_target="/${target##*/}"
else
    resolved_target="$resolved_target_dir/${target##*/}"
fi

umask 077
temp_file="$(mktemp "$resolved_target_dir/.sub-store-export.XXXXXX")" || fail "could not create a private temporary export file"
chmod 600 "$temp_file" || {
    rm -f "$temp_file"
    fail "could not secure the temporary export file"
}
paused=0
cleanup_export() {
    if [ "$paused" = "1" ]; then
        paused_state="$(docker inspect -f '{{.State.Paused}}' sub-store 2>/dev/null || true)"
        if [ "$paused_state" = "false" ]; then
            paused=0
        elif docker unpause sub-store >/dev/null; then
            paused=0
        else
            echo "WARNING: Export cleanup could not unpause sub-store. Start it manually." >&2
        fi
    fi
    [ -z "$temp_file" ] || rm -f "$temp_file"
}
trap cleanup_export EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
if docker inspect -f '{{.State.Running}}' sub-store 2>/dev/null | grep -qx true; then
    paused=1
    docker pause sub-store >/dev/null || fail "could not pause sub-store for a consistent export"
fi
result=0
tar -czf "$temp_file" -C "$VOLUME_PATH" . || result=$?
if [ "$result" -eq 0 ]; then
    chmod 600 "$temp_file" || result=$?
fi
if [ "$result" -eq 0 ] && [ "$paused" = "1" ]; then
    docker unpause sub-store >/dev/null || result=$?
    [ "$result" -ne 0 ] || paused=0
fi
if [ "$result" -eq 0 ]; then
    mv -f "$temp_file" "$resolved_target" || result=$?
fi
[ "$result" -eq 0 ] || fail "could not export sub-store data"
temp_file=""
echo "Exported sub-store data to $target"
command -v sha256sum >/dev/null 2>&1 && sha256sum "$resolved_target" || true
