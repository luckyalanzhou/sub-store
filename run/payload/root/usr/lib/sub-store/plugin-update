#!/bin/sh
set -eu

REPOSITORY=luckyalanzhou/sub-store
RELEASE_API="https://api.github.com/repos/$REPOSITORY/releases/latest"
STATE_DIR=/tmp/sub-store-plugin-update
CURRENT_VERSION_FILE=/etc/sub-store/version
MODE="${1:-}"

fail() {
    echo "plugin-update: $*" >&2
    exit 1
}

valid_version() {
    printf '%s\n' "$1" | awk '
        {
            if (split($0, part, /\./) != 3) exit 1
            for (i = 1; i <= 3; i++) {
                if (part[i] !~ /^[0-9]+$/ || (length(part[i]) > 1 && substr(part[i], 1, 1) == "0")) exit 1
            }
            valid = 1
        }
        END { if (!valid) exit 1 }
    ' >/dev/null 2>&1
}

compare_versions() {
    awk -v left="$1" -v right="$2" '
        BEGIN {
            split(left, a, /\./)
            split(right, b, /\./)
            for (i = 1; i <= 3; i++) {
                x = a[i]; y = b[i]
                sub(/^0+/, "", x); sub(/^0+/, "", y)
                if (x == "") x = "0"
                if (y == "") y = "0"
                if (length(x) > length(y)) { print 1; exit }
                if (length(x) < length(y)) { print -1; exit }
                for (j = 1; j <= length(x); j++) {
                    dx = substr(x, j, 1) + 0
                    dy = substr(y, j, 1) + 0
                    if (dx > dy) { print 1; exit }
                    if (dx < dy) { print -1; exit }
                }
            }
            print 0
        }
    '
}

fetch_latest() {
    release_json="$1/release.json"
    curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' --retry 2 \
        --connect-timeout 10 --max-time 30 \
        -H 'Accept: application/vnd.github+json' \
        -H 'X-GitHub-Api-Version: 2022-11-28' \
        --output "$release_json" "$RELEASE_API" || fail "Could not read the latest GitHub Release."
    latest_tag="$(jsonfilter -i "$release_json" -e '@.tag_name' 2>/dev/null | head -n 1)"
    case "$latest_tag" in
        v*) latest_version="${latest_tag#v}" ;;
        *) fail "The latest Release has an invalid version tag." ;;
    esac
    valid_version "$latest_version" || fail "The latest Release has an invalid version tag."
    printf '%s\n' "$latest_version"
}

write_state() {
    latest_version="$1"
    available="$2"
    mkdir -p "$STATE_DIR"
    umask 077
    printf '%s\n' "$latest_version" > "$STATE_DIR/latest-version.tmp"
    printf '%s\n' "$available" > "$STATE_DIR/update-available.tmp"
    mv "$STATE_DIR/latest-version.tmp" "$STATE_DIR/latest-version"
    mv "$STATE_DIR/update-available.tmp" "$STATE_DIR/update-available"
}

current_version="$(cat "$CURRENT_VERSION_FILE" 2>/dev/null || true)"
case "$MODE" in
    check|install|install-if-newer) ;;
    *) fail "usage: plugin-update {check|install|install-if-newer}" ;;
esac

command -v curl >/dev/null 2>&1 || fail "curl is unavailable."
command -v jsonfilter >/dev/null 2>&1 || fail "jsonfilter is unavailable."
command -v awk >/dev/null 2>&1 || fail "awk is unavailable."

TEMP_DIR="$(mktemp -d /tmp/sub-store-plugin-update.XXXXXX)" || fail "Could not create a temporary directory."
cleanup() { rm -rf "$TEMP_DIR"; }
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

latest_version="$(fetch_latest "$TEMP_DIR")"
if valid_version "$current_version"; then
    comparison="$(compare_versions "$latest_version" "$current_version")"
    [ "$comparison" -gt 0 ] && update_available=1 || update_available=0
else
    update_available=1
fi
write_state "$latest_version" "$update_available"

if [ "$MODE" = "check" ]; then
    printf '当前插件版本：%s\n最新插件版本：%s\n' "${current_version:-未知}" "$latest_version"
    if [ "$update_available" = "1" ]; then
        echo '发现新版本。'
    else
        echo '当前已是最新版本。'
    fi
    exit 0
fi

if [ "$MODE" = "install-if-newer" ] && [ "$update_available" = "0" ]; then
    echo "LuCI plugin $current_version is up to date (latest: $latest_version)."
    exit 0
fi

[ "$update_available" = "1" ] || fail "No newer plugin Release is available."
command -v sha256sum >/dev/null 2>&1 || fail "sha256sum is unavailable."
package_name="sub-store-$latest_version.run"
package="$TEMP_DIR/$package_name"
checksum="$package.sha256"
release_url="https://github.com/$REPOSITORY/releases/download/v$latest_version"

curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' --retry 2 \
    --connect-timeout 10 --max-time 180 --output "$package" \
    "$release_url/$package_name" || fail "Could not download the plugin package."
curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' --retry 2 \
    --connect-timeout 10 --max-time 30 --output "$checksum" \
    "$release_url/$package_name.sha256" || fail "Could not download the package checksum."
[ -s "$package" ] && [ -s "$checksum" ] || fail "The downloaded package or checksum is empty."

expected_hash="$(awk -v expected_file="$package_name" '
    NR == 1 && NF == 2 && $2 == expected_file && length($1) == 64 && $1 ~ /^[[:xdigit:]]+$/ {
        print tolower($1)
        valid = 1
    }
    END { if (!valid) exit 1 }
' "$checksum")" || fail "The checksum file does not match the package name."
actual_hash="$(sha256sum "$package" | awk '{print tolower($1)}')"
[ "$actual_hash" = "$expected_hash" ] || fail "Package SHA-256 verification failed."

chmod 700 "$package"
"$package" --check || fail "The self-extracting installer failed its archive check."
echo "Verified $package_name (SHA-256). Installing the LuCI plugin only..."
SUB_STORE_PLUGIN_ONLY=1 "$package"

installed_version="$(cat "$CURRENT_VERSION_FILE" 2>/dev/null || true)"
[ "$installed_version" = "$latest_version" ] || fail "The installer returned without installing the requested plugin version."
write_state "$latest_version" 0
echo "LuCI plugin updated to $installed_version. The Docker image and container were not changed."
