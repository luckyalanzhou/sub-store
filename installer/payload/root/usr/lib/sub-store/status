#!/usr/bin/lua
local sys = require "luci.sys"
local json = require "luci.jsonc"
local function read(path)
    local f = io.open(path, "r")
    if not f then return "" end
    local value = f:read("*a") or ""
    f:close()
    return value:gsub("%s+$", "")
end
local state = "/tmp/sub-store-operation/"
local plugin_update = "/tmp/sub-store-plugin-update/"
local operation_state_trusted = sys.call(
    "[ -d /tmp/sub-store-operation ] && [ ! -L /tmp/sub-store-operation ] && " ..
    "[ \"$(stat -c '%u:%a' /tmp/sub-store-operation 2>/dev/null)\" = '0:700' ]"
) == 0
local function operation_snapshot()
    if not operation_state_trusted then return nil end
    local f = io.open("/tmp/sub-store-operation/snapshot", "r")
    if not f then return nil end
    local version = f:read("*l")
    local id = f:read("*l")
    local action = f:read("*l")
    local phase = f:read("*l")
    local operation = f:read("*l") or ""
    f:close()
    if version ~= "sub-store-operation-v1" or not id or id == "" or
        not action or action == "" or not phase or phase == "" or operation == "" then
        return nil
    end
    return { id = id, action = action, phase = phase, operation = operation }
end
local function command(value)
    return (sys.exec("( " .. value .. " ) 2>/dev/null") or ""):gsub("%s+$", "")
end
local function plugin_update_state()
    local latest_path = plugin_update .. "latest-version"
    local available_path = plugin_update .. "update-available"
    local trusted = sys.call(
        "[ -d /tmp/sub-store-plugin-update ] && [ ! -L /tmp/sub-store-plugin-update ] && " ..
        "[ \"$(stat -c '%u:%a' /tmp/sub-store-plugin-update 2>/dev/null)\" = '0:700' ] && " ..
        "[ -f " .. latest_path .. " ] && [ ! -L " .. latest_path .. " ] && " ..
        "[ \"$(stat -c '%u:%a:%h' " .. latest_path .. " 2>/dev/null)\" = '0:600:1' ] && " ..
        "[ -f " .. available_path .. " ] && [ ! -L " .. available_path .. " ] && " ..
        "[ \"$(stat -c '%u:%a:%h' " .. available_path .. " 2>/dev/null)\" = '0:600:1' ]"
    ) == 0
    if not trusted then return "", false end
    return read(latest_path), read(available_path) == "1"
end
local mode = arg[1] or "summary"
local busy = operation_state_trusted and sys.call(
    "[ -d /tmp/sub-store-operation/lock ] && [ ! -L /tmp/sub-store-operation/lock ] && " ..
    "[ \"$(stat -c '%u:%a' /tmp/sub-store-operation/lock 2>/dev/null)\" = '0:700' ] && " ..
    "[ -f /tmp/sub-store-operation/lock/pid ] && [ ! -L /tmp/sub-store-operation/lock/pid ] && " ..
    "[ \"$(stat -c '%u:%a:%h' /tmp/sub-store-operation/lock/pid 2>/dev/null)\" = '0:600:1' ] && " ..
    "grep -Eq '^[1-9][0-9]*$' /tmp/sub-store-operation/lock/pid 2>/dev/null && " ..
    "kill -0 \"$(cat /tmp/sub-store-operation/lock/pid 2>/dev/null)\" 2>/dev/null"
) == 0
local operation = operation_snapshot()
local result = {
    container = busy and "maintenance" or command("/usr/bin/sub-storectl status"),
    version = read("/etc/sub-store/version"),
    operation_id = operation and operation.id or "",
    phase = operation and operation.phase or (operation_state_trusted and read(state .. "phase") or ""),
    action = operation and operation.action or (operation_state_trusted and read(state .. "action") or ""),
    operation = operation and operation.operation or (operation_state_trusted and read(state .. "status") or ""),
    busy = busy
}
-- Docker CLI calls can stall while dockerd pulls or replaces an image. Keep
-- polling cheap during maintenance; the next poll reads full details again.
if not busy and result.container == "running" then
    result.health = command("/usr/bin/sub-storectl health")
end
if mode == "logs" or mode == "maintenance-log" or mode == "details" then
    if operation_state_trusted then
        result.output = command("tail -n 100 /tmp/sub-store-operation/output.log")
    end
end
if mode == "logs" or mode == "runtime-log" or mode == "details" then
    if not busy then
        result.container_log = command("docker logs --tail 100 sub-store 2>&1")
    end
end
if mode == "details" and not busy then
    result.url = command("/usr/bin/sub-storectl url")
    result.api_url = command("/usr/bin/sub-storectl api-url")
    result.storage = command("/usr/bin/sub-storectl storage")
    result.image = command("docker inspect -f '{{.Config.Image}} / {{.Image}}' sub-store")
    result.created = command("docker inspect -f '{{.Created}}' sub-store")
    result.app_version = command("/usr/bin/sub-storectl app-version")
    result.plugin_latest_version, result.plugin_update_available = plugin_update_state()
end
io.write(json.stringify(result), "\n")
